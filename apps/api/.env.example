# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Flutterwave server-side payment configuration.
# Never commit real credentials.
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""
FLUTTERWAVE_REDIRECT_URL=""

# Private messaging attachment storage. Use "s3" in production or "mock" for tests only.
ATTACHMENT_STORAGE_PROVIDER="s3"
ATTACHMENT_STORAGE_BUCKET=""
ATTACHMENT_STORAGE_REGION=""
ATTACHMENT_STORAGE_ENDPOINT=""
ATTACHMENT_STORAGE_FORCE_PATH_STYLE="false"
ATTACHMENT_STORAGE_ACCESS_KEY_ID=""
ATTACHMENT_STORAGE_SECRET_ACCESS_KEY=""
ATTACHMENT_UPLOAD_URL_TTL_SECONDS="900"
ATTACHMENT_ACCESS_URL_TTL_SECONDS="300"

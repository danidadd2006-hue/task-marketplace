// use prisma-next

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum UserRole {
  CLIENT
  WORKER
  ADMIN
}

enum ProfileType {
  INDIVIDUAL
  BUSINESS
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  phone             String?    @unique
  passwordHash      String
  status            UserStatus @default(ACTIVE)
  role              UserRole   @default(CLIENT)
  emailVerified     Boolean    @default(false)
  phoneVerified     Boolean    @default(false)
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  profile           Profile?
  location          UserLocation?
  tasks             Task[]
  applications      Application[]
  messages          Message[]
  conversations     ConversationMember[]
  refreshTokens     RefreshToken[]
  roleAssignments   UserRoleAssignment[]
  payoutDestinations PayoutDestination[]
  payoutsAsWorker   Payout[] @relation("WorkerPayouts")
  cancellationsAsActor Cancellation[] @relation("CancellationActors")
  workerCancellationPenalties WorkerCancellationPenalty[] @relation("WorkerCancellationPenalties")
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices PushDevice[]
  notificationDeliveryAttempts NotificationDeliveryAttempt[] @relation("NotificationAttemptRecipients")
  reviewsGiven      Review[] @relation("ReviewReviewer")
  reviewsReceived   Review[] @relation("ReviewReviewee")
  verifications     Verification[] @relation("VerificationSubject")
  verificationsRevoked Verification[] @relation("VerificationRevokers")
  verificationReviews Verification[] @relation("VerificationReviewers")
  verificationHistoryActors VerificationHistory[] @relation("VerificationHistoryActors")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  role      UserRole
  assignedBy String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

model Profile {
  id                String      @id @default(uuid())
  userId            String      @unique
  type              ProfileType @default(INDIVIDUAL)
  displayName       String
  bio               String?
  profilePhotoUrl   String?
  websiteUrl        String?
  yearsExperience   Int?
  averageRating     Decimal?
  totalReviews      Int         @default(0)
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Country {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  currency    String
  timezone    String

  regions     Region[]
  cities      City[]
  userLocations UserLocation[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Region {
  id          String   @id @default(uuid())
  countryId   String
  name        String

  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities      City[]
  userLocations UserLocation[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([countryId, name])
}

model City {
  id          String   @id @default(uuid())
  countryId   String
  regionId    String?
  name        String

  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region      Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  userLocations UserLocation[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([countryId, name])
}

model UserLocation {
  id          String   @id @default(uuid())
  userId      String   @unique
  countryId   String
  regionId    String?
  cityId      String?
  area        String?
  latitude    Decimal?
  longitude   Decimal?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  region      Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}
model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  parentId    String?

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  tasks       Task[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([parentId, name])
  @@index([parentId])
  @@index([active, sortOrder])
}
enum TaskType {
  PHYSICAL
  VIRTUAL
}

enum TaskDuration {
  SHORT_TERM
  LONG_TERM
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  RECEIVING_APPLICATIONS
  WORKER_SELECTED
  AWAITING_PAYMENT
  FUNDED
  IN_PROGRESS
  SUBMITTED
  AWAITING_APPROVAL
  COMPLETED
  CANCELLED
  DISPUTED
  EXPIRED
}
enum ApplicationStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}
model Task {
  id                    String       @id @default(uuid())
  clientId              String
  categoryId            String
  title                 String
  description           String
  type                  TaskType
  duration              TaskDuration
  status                TaskStatus   @default(DRAFT)
  currency              String
  budgetMin             Decimal?
  budgetMax             Decimal?
  expectedCompletionAt  TimestamptzString?
  locationDescription   String?
  requirements          String?
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  client                User         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category              Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requirementsList      TaskRequirement[]
  attachments           TaskAttachment[]
  contract              Contract?
  payouts               Payout[]
  applications          Application[]
  cancellations         Cancellation[]
  conversations         Conversation[]
  notifications         Notification[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
  @@index([type, duration])
}
model TaskRequirement {
  id        String   @id @default(uuid())
  taskId    String
  name      String
  value     String?

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([taskId])
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  fileUrl   String
  fileName  String?
  fileType  String?
  fileSize  Int?

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([taskId])
}
model Application {
  id                    String            @id @default(uuid())
  taskId                String
  workerId              String
  proposedPrice         Decimal
  estimatedCompletionAt TimestamptzString?
  message               String?
  qualifications        String?
  questions             String?
  status                ApplicationStatus @default(SUBMITTED)
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  task                  Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker                User              @relation(fields: [workerId], references: [id], onDelete: Restrict)
  attachments           ApplicationAttachment[]
  notifications         Notification[]

  @@unique([taskId, workerId])
  @@index([taskId])
  @@index([workerId])
  @@index([status])
}
model ApplicationAttachment {
  id            String      @id @default(uuid())
  applicationId String
  fileUrl       String
  fileName      String?
  fileType      String?
  fileSize      Int?

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([applicationId])
}
enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CancellationActorType {
  CLIENT
  WORKER
  ADMIN
}

enum CancellationStage {
  DRAFT
  PUBLISHED
  RECEIVING_APPLICATIONS
  WORKER_SELECTED
  AWAITING_PAYMENT
  FUNDED
  IN_PROGRESS
  EXPIRED
}

enum CancellationCategory {
  PRE_WORK_FIRST_DAY
  SHORT_JOB_SECOND_DAY
  LONG_JOB_ELAPSED
  EXTENSION
  EXPIRY_REFUND
  ADMINISTRATIVE
}

enum CancellationCalculationBasis {
  NO_FINANCIAL_ALLOCATION
  FIRST_DAY_FULL_REFUND
  SHORT_JOB_FIXED_ALLOCATION
  LONG_JOB_ELAPSED_ALLOCATION
  EXTENSION_FULL_REFUND
  EXPIRY_FULL_REFUND
  ADMINISTRATIVE
}

enum CancellationFinancialClassification {
  NO_FINANCIAL_ACTION
  FULL_REFUND
  PARTIAL_REFUND
}

enum RefundType {
  FULL
  PARTIAL
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
}

model Contract {
  id          String         @id @default(uuid())
  taskId      String         @unique
  workerId    String
  status      ContractStatus @default(ACTIVE)
  agreedPrice Decimal
  startedAt   TimestamptzString?
  completedAt TimestamptzString?
  hiredAt TimestamptzString @default(now())
  agreedDurationDays Int?
  extensionStartedAt TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  task        Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  worker      User           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  payout      Payout?
  cancellations Cancellation[]
  conversations Conversation[]
  notifications Notification[]
  reviews      Review[]

  @@index([workerId])
  @@index([status])
}
enum PaymentStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
  FAILED
  DISPUTED
  CANCELLED
}

enum PaymentProviderEventType {
  FUNDING_SUCCEEDED
  FUNDING_FAILED
  FUNDING_CANCELLED
}

model PaymentProviderEvent {
  id              String                    @id @default(uuid())
  provider        String
  providerEventId String
  type            PaymentProviderEventType
  paymentId       String
  providerRef     String?
  metadata        String?
  processedAt     TimestamptzString         @default(now())
  createdAt       TimestamptzString         @default(now())

  payment         Payment                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([type])
  @@index([processedAt])
}
model Cancellation {
  id                         String                           @id @default(uuid())
  taskId                     String
  contractId                 String?
  paymentId                  String?
  actorId                    String
  actorType                  CancellationActorType
  stage                      CancellationStage
  category                   CancellationCategory
  calculationBasis           CancellationCalculationBasis
  reason                     String?
  agreedDurationDays         Int?
  hiredAt                    TimestamptzString?
  firstDayBoundaryAt         TimestamptzString?
  extensionStartedAt         TimestamptzString?
  cancellationAt             TimestamptzString
  elapsedApplicableSeconds   BigInt?
  applicableDurationSeconds  BigInt?
  fundedAmount               Decimal?
  currency                   String
  workerPercentage           Decimal
  workerAmount               Decimal
  cancellationFee            Decimal
  clientRefund               Decimal
  financialClassification    CancellationFinancialClassification
  metadata                   String?
  createdAt                  TimestamptzString @default(now())

  task                       Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  contract                   Contract?        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payment                    Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor                      User             @relation("CancellationActors", fields: [actorId], references: [id], onDelete: Restrict)
  refund                     Refund?

  @@index([taskId])
  @@index([contractId])
  @@index([paymentId])
  @@index([actorId])
  @@index([stage])
  @@index([category])
  @@index([cancellationAt])
  @@index([financialClassification])
}

model Refund {
  id                       String        @id @default(uuid())
  paymentId                String
  cancellationId           String        @unique
  amount                   Decimal
  currency                 String
  type                     RefundType
  status                   RefundStatus  @default(PENDING)
  provider                 String?
  providerRef              String?
  idempotencyKey           String        @unique
  failureCode              String?
  failureMessage           String?
  uncertaintyReason        String?
  reconciliationMetadata  String?
  initiatedAt              TimestamptzString?
  succeededAt              TimestamptzString?
  reconciledAt             TimestamptzString?
  createdAt                TimestamptzString @default(now())
  updatedAt                temporal.updatedAtString()

  payment                  Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cancellation             Cancellation   @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  providerEvents           RefundProviderEvent[]

  @@unique([provider, providerRef])
  @@index([paymentId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
}

model RefundProviderEvent {
  id              String        @id @default(uuid())
  provider        String
  providerEventId String
  refundId        String
  type            String
  providerRef     String?
  metadata        String?
  processedAt     TimestamptzString @default(now())
  createdAt       TimestamptzString @default(now())

  refund          Refund        @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([refundId])
  @@index([type])
  @@index([processedAt])
}

model WorkerCancellationPenalty {
  id                    String   @id @default(uuid())
  workerId              String
  cancellationId        String   @unique
  rollingPeriodAnchorAt TimestamptzString
  sequenceNumber        Int
  banDurationDays       Int
  banStartedAt          TimestamptzString
  banEndsAt             TimestamptzString
  warningIssuedAt       TimestamptzString?
  createdAt             TimestamptzString @default(now())

  worker                User         @relation("WorkerCancellationPenalties", fields: [workerId], references: [id], onDelete: Restrict)
  cancellation          Cancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)

  @@index([workerId, createdAt], map: "wcp_worker_created_idx")
  @@index([workerId, rollingPeriodAnchorAt], map: "wcp_worker_period_idx")
  @@check(expression: "\"sequenceNumber\" >= 1 AND \"sequenceNumber\" <= 3", name: "worker_cancellation_penalty_sequence_check")
}

model Payment {
  id          String        @id @default(uuid())
  taskId      String
  clientId    String
  workerId    String?
  contractId  String
  amount      Decimal
  currency    String
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  fundedAt    TimestamptzString?
  releasedAt  TimestamptzString?
  refundedAt  TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  client      User          @relation("ClientPayments", fields: [clientId], references: [id], onDelete: Restrict)
  worker      User?         @relation("WorkerPayments", fields: [workerId], references: [id], onDelete: Restrict)
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  providerEvents PaymentProviderEvent[]
  payout      Payout?
  cancellations Cancellation[]
  refunds      Refund[]
  notifications Notification[]

  @@index([taskId])
  @@index([contractId])
  @@index([clientId])
  @@index([workerId])
  @@index([status])
}
model PayoutDestination {
  id                 String             @id @default(uuid())
  userId             String
  provider           String
  method             String
  providerAccountRef String
  status             VerificationStatus @default(PENDING)
  verifiedAt         TimestamptzString?
  createdAt          TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts            Payout[]

  @@unique([provider, providerAccountRef])
  @@index([userId])
  @@index([status])
}

model Payout {
  id                     String        @id @default(uuid())
  paymentId              String        @unique
  contractId             String        @unique
  taskId                 String
  workerId               String
  payoutDestinationId    String
  amount                 Decimal
  currency               String
  provider               String?
  providerRef            String?
  status                 String        @default("PENDING")
  failureCode            String?
  failureMessage         String?
  uncertaintyReason      String?
  reconciliationMetadata String?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  payment                Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  contract               Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  task                   Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  worker                 User          @relation("WorkerPayouts", fields: [workerId], references: [id], onDelete: Restrict)
  payoutDestination      PayoutDestination @relation(fields: [payoutDestinationId], references: [id], onDelete: Restrict)
  providerEvents         PayoutProviderEvent[]

  @@index([taskId])
  @@index([workerId])
  @@index([payoutDestinationId])
  @@index([status])
}

model PayoutProviderEvent {
  id              String                  @id @default(uuid())
  provider        String
  providerEventId String
  type            String
  payoutId        String
  providerRef     String?
  metadata        String?
  processedAt     TimestamptzString       @default(now())
  createdAt       TimestamptzString       @default(now())

  payout          Payout                  @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([payoutId])
  @@index([type])
  @@index([processedAt])
}

model TokenWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
enum TokenTransactionType {
  GRANT
  PURCHASE
  SPEND
  REFUND
  ADJUSTMENT
  EXPIRY
}

model TokenTransaction {
  id        String               @id @default(uuid())
  userId    String
  type      TokenTransactionType
  amount    Int
  balanceAfter Int
  reference String?
  note      String?

  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
model TokenPackage {
  id          String   @id @default(uuid())
  name        String
  tokenAmount Int
  price       Decimal
  currency    String
  active      Boolean  @default(true)

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([active])
}
model Review {
  id                   String     @id @default(uuid())
  contractId           String
  reviewerId           String
  revieweeId           String
  type                 ReviewType
  rating               Int
  communicationRating  Int
  reliabilityRating    Int
  qualityRating        Int
  professionalismRating Int
  comment              String?
  createdAt            TimestamptzString @default(now())

  contract             Contract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reviewer             User       @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee             User       @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([contractId, type])
  @@index([contractId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@check(expression: "\"rating\" >= 1 AND \"rating\" <= 5", name: "review_rating_bounds")
  @@check(expression: "\"communicationRating\" >= 1 AND \"communicationRating\" <= 5", name: "review_communication_rating_bounds")
  @@check(expression: "\"reliabilityRating\" >= 1 AND \"reliabilityRating\" <= 5", name: "review_reliability_rating_bounds")
  @@check(expression: "\"qualityRating\" >= 1 AND \"qualityRating\" <= 5", name: "review_quality_rating_bounds")
  @@check(expression: "\"professionalismRating\" >= 1 AND \"professionalismRating\" <= 5", name: "review_professionalism_rating_bounds")
}
model Conversation {
  id         String   @id @default(uuid())
  taskId     String?
  contractId String?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  members    ConversationMember[]
  messages   Message[]

  @@index([taskId])
  @@index([contractId])
}
model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      TimestamptzString @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}
enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  LOCATION
}
enum MessageAttachmentStatus {
  PENDING
  READY
  FAILED
}
enum ReviewType {
  CLIENT_TO_WORKER
  WORKER_TO_CLIENT
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  location       MessageLocation?
  type           MessageType   @default(TEXT)
  content        String?
  // Legacy attachment fields retained temporarily for compatibility; new messaging architecture must use MessageAttachment.
  fileUrl        String?
  fileName       String?
  latitude       Decimal?
  longitude      Decimal?

  attachments    MessageAttachment[]
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Restrict)
  notifications  Notification[]

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])

}
model MessageAttachment {
  id               String                 @id @default(uuid())
  messageId        String
  storageKey       String
  originalFilename String?
  mimeType         String
  size             BigInt
  checksum         String
  status           MessageAttachmentStatus @default(PENDING)
  createdAt        TimestamptzString      @default(now())

  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}
model MessageLocation {
  id          String   @id @default(uuid())
  messageId   String   @unique
  latitude    Decimal
  longitude   Decimal
  accuracy    Decimal?
  expiresAt   TimestamptzString?

  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt   TimestamptzString @default(now())
}
enum LedgerEntryType {
  FUNDING
  RELEASE
  COMMISSION
  REFUND
  CANCELLATION_FEE
  ADJUSTMENT
}

model LedgerEntry {
  id          String           @id @default(uuid())
  paymentId   String?
  taskId      String?
  userId      String?
  type        LedgerEntryType
  amount      Decimal
  currency    String
  description String?
  reference   String?
  createdAt   TimestamptzString @default(now())

  @@index([paymentId])
  @@index([taskId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id          String        @id @default(uuid())
  taskId      String
  paymentId   String?
  raisedById  String
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([taskId])
  @@index([paymentId])
  @@index([raisedById])
  @@index([status])
}

model DisputeEvidence {
  id          String   @id @default(uuid())
  disputeId   String
  fileUrl     String?
  description String?
  createdAt   TimestamptzString @default(now())

  @@index([disputeId])
}
enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reportedUserId String?
  taskId      String?
  messageId   String?
  reason      String
  description String
  status      ReportStatus @default(OPEN)
  resolution  String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([taskId])
  @@index([messageId])
  @@index([status])
}
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum VerificationType {
  IDENTITY
  PHONE
  EMAIL
  PAYMENT
  ADDRESS
  BUSINESS
  QUALIFICATION
}

enum VerificationChallengeType {
  EMAIL
  PHONE
}

model Verification {
  id             String             @id @default(uuid())
  userId         String
  type           VerificationType
  status         VerificationStatus @default(PENDING)
  provider       String?
  providerRef    String?
  verifiedAt     TimestamptzString?
  expiresAt      TimestamptzString?
  reviewedAt     TimestamptzString?
  reviewedById   String?
  decisionReason String?
  revokedAt      TimestamptzString?
  revokedById    String?
  revocationReason String?
  activeKey      String?            @unique
  notes          String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  user           User               @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Restrict)
  reviewer       User?              @relation("VerificationReviewers", fields: [reviewedById], references: [id], onDelete: Restrict)
  revoker        User?              @relation("VerificationRevokers", fields: [revokedById], references: [id], onDelete: Restrict)
  challenges     VerificationChallenge[]
  evidence       VerificationEvidence[]
  history        VerificationHistory[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([userId, type, status])
}

model VerificationChallenge {
  id             String                   @id @default(uuid())
  verificationId String
  type           VerificationChallengeType
  challengeHash  String
  expiresAt      TimestamptzString
  usedAt         TimestamptzString?
  createdAt      TimestamptzString        @default(now())

  verification   Verification             @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
  @@index([type, expiresAt])
  @@unique([verificationId, type, usedAt])
}

model VerificationEvidence {
  id             String             @id @default(uuid())
  verificationId String
  storageRef     String
  checksum      String?
  mimeType      String?
  sizeBytes     BigInt?
  originalName  String?
  createdAt     TimestamptzString @default(now())

  verification  Verification      @relation(fields: [verificationId], references: [id], onDelete: Restrict)

  @@index([verificationId])
  @@index([checksum])
}

model VerificationHistory {
  id             String             @id @default(uuid())
  verificationId String
  fromStatus     VerificationStatus?
  toStatus       VerificationStatus
  actorId        String?
  reason         String?
  createdAt      TimestamptzString @default(now())

  verification   Verification      @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  actor          User?              @relation("VerificationHistoryActors", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([verificationId, createdAt])
  @@index([actorId])
}
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VERIFY
  PAYMENT
  REFUND
  DISPUTE
  REPORT
  ADMIN_ACTION
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  TimestamptzString @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
enum NotificationType {
  MESSAGE
  APPLICATION
  CONTRACT
  PAYMENT
  REVIEW
  DISPUTE
  REPORT
  VERIFICATION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  ACTIVE
  EXPIRED
  SUPPRESSED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum PushDeviceStatus {
  ACTIVE
  REVOKED
  INVALID
}

model Notification {
  id                String             @id @default(uuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  eventId           String
  eventType         String
  aggregateType     String
  aggregateId       String
  taskId            String?
  contractId        String?
  applicationId     String?
  paymentId         String?
  messageId         String?
  referenceMetadata String?
  deepLink          String?
  status            NotificationStatus @default(ACTIVE)
  readAt            TimestamptzString?
  expiresAt         TimestamptzString?
  createdAt         TimestamptzString @default(now())

  recipient         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  task              Task?              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  contract          Contract?          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  application       Application?       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  messageRecord     Message?           @relation(fields: [messageId], references: [id], onDelete: Restrict)
  deliveryAttempts  NotificationDeliveryAttempt[]

  @@unique([eventId, userId, type], map: "notification_event_recipient_type_key")
  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([eventType, aggregateType, aggregateId])
  @@index([taskId])
  @@index([contractId])
  @@index([applicationId])
  @@index([paymentId])
  @@index([messageId])
  @@index([status, expiresAt])
}

model NotificationPreference {
  id          String             @id @default(uuid())
  userId      String
  type        NotificationType
  channel     NotificationChannel
  enabled     Boolean            @default(true)
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, channel], map: "notification_preference_user_type_channel_key")
  @@index([userId])
  @@index([type, channel])
}

model NotificationDeliveryAttempt {
  id              String                     @id @default(uuid())
  notificationId  String
  recipientUserId String
  channel         NotificationChannel
  attemptNumber   Int
  status          NotificationDeliveryStatus @default(PENDING)
  startedAt       TimestamptzString?
  completedAt     TimestamptzString?
  provider        String?
  providerRef     String?
  providerOutcome String?
  errorClass      String?
  uncertaintyInfo String?
  createdAt       TimestamptzString         @default(now())

  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  recipient       User         @relation("NotificationAttemptRecipients", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel, attemptNumber], map: "notification_delivery_attempt_key")
  @@index([notificationId])
  @@index([recipientUserId, channel, status], map: "nda_recipient_channel_status_idx")
  @@index([channel, status, createdAt], map: "nda_channel_status_created_idx")
}

model PushDevice {
  id           String           @id @default(uuid())
  userId       String
  provider     String
  platform     String
  token        String
  status       PushDeviceStatus @default(ACTIVE)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  revokedAt    TimestamptzString?

  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, token], map: "push_device_provider_token_key")
  @@index([userId, status])
  @@index([provider, platform, status])
}
model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   TimestamptzString
  revokedAt   TimestamptzString?
  createdAt   TimestamptzString @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
